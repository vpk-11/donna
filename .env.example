# Donna env vars — local Ollama setup, no cloud LLM in the loop.
# Copy the vars you want into .env and .env.example. Not read automatically —
# config.py's Settings still reads from .env directly (see the existing
# env_file=".env" contradiction, tracked in .claude/context/decisions.md).

# --- LLM (Ollama, local) ---
# litellm's ollama_chat/ prefix, not ollama/ — needed for reliable
# response_format={"type":"json_object"} handling (intent parser, judge both use it).
LLM_MODEL=ollama_chat/qwen2.5:7b-instruct
# Ollama's default local server address. Change only if Ollama runs elsewhere.
LLM_API_BASE=http://localhost:11434 # Only needed for local Ollama, cloud providers ignore this.
# Not used by Ollama. Left blank on purpose — set this (and swap LLM_MODEL/
# LLM_API_BASE) if you ever point Donna back at a cloud provider.
LLM_API_KEY=
# Optional per-call model override for one-off testing. Leave blank to use LLM_MODEL.
DONNA_MODEL=

# --- Provider bootstrap (required — no default, server won't start without these) ---
# The admin's phone number. Routes this number to admin mode instead of client mode.
ADMIN_PHONE=+15550000000
# The admin's display name, used in Donna's messages ("You're live with...").
ADMIN_NAME=Kaushik

# --- Provider bootstrap (optional, sensible defaults already in config.py) ---
BUSINESS_TYPE=trainer
LOCATION_TYPE=mobile
AUTO_BOOK=false
BUFFER_MINS=15
WORKING_HOURS={"mon":["09:00","18:00"],"tue":["09:00","18:00"],"wed":["09:00","18:00"],"thu":["09:00","18:00"],"fri":["09:00","18:00"]}

# --- Redis (required at runtime — main.py's lifespan calls ping_redis() and
# raises if unreachable; not a pydantic-settings field, read directly via
# os.environ in db/redis_client.py) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Optional, unused unless the corresponding feature is wired up ---
GOOGLE_MAPS_API_KEY=
LINQ_API_TOKEN=
LINQ_PHONE_NUMBER=
LINQ_DEVELOPER_PHONE=

# --- Server ---
PORT=8000
